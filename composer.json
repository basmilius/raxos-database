{
    "name": "raxos/database",
    "description": "Database ORM and Query Builder.",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "type": "library",
    "authors": [
        {
            "name": "Bas Milius",
            "email": "bas@mili.us"
        }
    ],
    "autoload": {
        "files": [
            "src/Query/functions.php"
        ],
        "psr-4": {
            "Raxos\\Database\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "symlink": true
        }
    ],
    "require": {
        "ext-pdo": "*",
        "jetbrains/phpstorm-attributes": "^1.2",
        "php": ">=8.5",
        "raxos/collection": "^3.3",
        "raxos/contract": "^3.3",
        "raxos/error": "^3.2",
        "raxos/foundation": "^3.2"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload-dev": {
        "classmap": [
            "tests/Fixtures/"
        ]
    },
    "scripts": {
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.3.x-dev"
        }
    }
}
